<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RtlTcp.Core\RtlTcp.Core.csproj" />
  </ItemGroup>

  <!--
    libusb (LGPL-2.1) stays a separate, replaceable file next to the program - never embedded
    into a single-file bundle. See THIRD-PARTY-NOTICES.md.
    Development builds (no RuntimeIdentifier): all Windows variants under runtimes/, picked at runtime.
    Release builds: RtlTcp.Server.csproj copies only the DLL for its RuntimeIdentifier (the RID does not
    flow into referenced library projects), so nothing from here goes into a publish folder.
  -->
  <ItemGroup>
    <None Include="runtimes\**\libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never"
          Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="runtimes\LIBUSB-COPYING.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never"
          Link="LIBUSB-COPYING.txt" />
  </ItemGroup>

</Project>
