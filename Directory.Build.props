<Project>
  <PropertyGroup>
    <!--
      Version: single source of truth for local builds. Release builds override it with
      -p:Version=x.y.z (computed from the commits since the last tag, like home.control).
      Bump here only for a new base version (e.g. 1.0.0).
    -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Jürgen Laschak</Authors>
    <Product>rtltcp.server</Product>
    <Copyright>Copyright (c) 2026 Jürgen Laschak</Copyright>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
  </PropertyGroup>
</Project>
